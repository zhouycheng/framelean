        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "display_name",
        "description",
        "applicable",
        "policy_version",
        "policy",
        "risks"
