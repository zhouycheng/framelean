    "PresetPolicy": {
      "type": "object",
      "properties": {
        "applicable_task_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskMode"
          }
        },
        "audio_bitrate_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
