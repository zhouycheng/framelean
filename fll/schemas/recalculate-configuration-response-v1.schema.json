        "ENGINE_EXECUTION_CHAIN_NOT_READY",
        "MEDIA_CAPABILITY_INCOMPATIBLE",
        "PRESET_NOT_APPLICABLE",
        "TARGET_SIZE_UNACHIEVABLE",
        "OUTPUT_CONTAINER_NOT_WRITABLE",
        "MEDIA_DURATION_UNAVAILABLE",
        "MEDIA_STREAM_UNRECOGNIZED",
        "MEDIA_PROFILE_UNAVAILABLE",
        "MEDIA_PIXEL_FORMAT_UNAVAILABLE",
        "MEDIA_BIT_DEPTH_UNAVAILABLE",
        "MEDIA_HDR_STATE_INCOMPLETE",
        "MEDIA_ANIMATION_STATE_NOT_PROBED"
      ]
    },
    "ErrorDetail": {
      "type": "object",
      "properties": {
        "code": {
