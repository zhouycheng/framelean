        "container": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_pixel_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "preserves_hdr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "video_codec": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PresetDefinition": {
      "type": "object",
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionChainCandidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedConfiguration"
            },
            {
              "type": "null"
            }
          ]
