          "properties": {
            "mode": {
              "type": "string",
              "const": "custom_target_size"
            },
            "selection": {
              "$ref": "#/$defs/TargetSizeSelection"
            }
          },
          "required": [
            "mode",
            "selection"
          ]
        },
        {
          "type": "object",
          "properties": {
