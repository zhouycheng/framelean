      "required": [
        "available",
        "containers",
        "video_codecs",
        "audio_codecs",
        "image_formats",
        "demuxers",
        "decoders",
        "processors",
        "encoders",
        "muxers",
        "execution_chains",
        "diagnostics",
        "exclusions"
