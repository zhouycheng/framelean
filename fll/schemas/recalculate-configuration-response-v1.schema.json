          "type": [
            "string",
            "null"
          ]
        },
        "output_video_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "preserves_hdr": {
          "type": "boolean"
        },
        "processors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessorSelection"
          }
        },
        "requires_tone_mapping": {
          "type": "boolean"
        },
        "video_decoders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StreamBackendSelection"
          }
        },
        "video_encoder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "demuxer",
        "video_decoders",
        "audio_decoders",
        "processors",
        "muxer",
        "output_container",
        "audio_bitrate_options_bps",
        "audio_sample_rate_options_hz",
        "audio_channel_count_options",
        "output_hdr_mode",
        "preserves_hdr",
        "requires_tone_mapping"
      ]
